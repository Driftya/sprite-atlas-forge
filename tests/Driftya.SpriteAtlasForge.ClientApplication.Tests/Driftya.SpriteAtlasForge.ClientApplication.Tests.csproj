<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Driftya.SpriteAtlasForge.Application\Driftya.SpriteAtlasForge.Application.csproj" />
    <ProjectReference Include="..\..\src\Driftya.SpriteAtlasForge.ClientApplication\Driftya.SpriteAtlasForge.ClientApplication.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the platform-neutral view model source without bootstrapping the WinUI executable host. -->
    <Compile Include="..\..\src\Driftya.SpriteAtlasForge.ClientApplication\PageModels\WorkspacePageModel.cs"
             Link="Production\WorkspacePageModel.cs" />
    <Compile Include="..\..\src\Driftya.SpriteAtlasForge.ClientApplication\Services\IWorkspaceFilePicker.cs"
             Link="Production\IWorkspaceFilePicker.cs" />
  </ItemGroup>
</Project>
