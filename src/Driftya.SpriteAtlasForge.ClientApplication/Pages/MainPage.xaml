<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Driftya.SpriteAtlasForge.ClientApplication.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:Driftya.SpriteAtlasForge.ClientApplication.PageModels"
    x:DataType="pageModels:WorkspacePageModel"
    Title="Atlas Workspace">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Open image" IsEnabled="False" />
                <Button Grid.Column="1" Text="Open project" IsEnabled="False" />
                <Button Grid.Column="2" Text="Save" IsEnabled="False" />
                <Button Grid.Column="3" Text="Detect" IsEnabled="False" />
                <Label
                    Grid.Column="5"
                    VerticalOptions="Center"
                    Text="{Binding Status}"
                    TextColor="{StaticResource MutedTextColor}" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="16"
            ColumnDefinitions="240,*,280"
            ColumnSpacing="12">

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Label Text="Sprites" Style="{StaticResource SectionTitleStyle}" />
                    <Entry Grid.Row="1" Placeholder="Search sprites" IsEnabled="False" />
                    <VerticalStackLayout Grid.Row="2" VerticalOptions="Center" Spacing="6">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="No sprites detected"
                            TextColor="{StaticResource MutedTextColor}" />
                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="Image import arrives in Phase 2"
                            TextColor="{StaticResource MutedTextColor}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CanvasBorderStyle}">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="10">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource PageTitleStyle}"
                        Text="{Binding Title}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="520"
                        Text="{Binding Description}"
                        TextColor="{StaticResource MutedTextColor}" />
                    <Border
                        Margin="0,8,0,0"
                        Padding="12,6"
                        BackgroundColor="{StaticResource AccentSurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                        <Label FontSize="12" Text="Windows desktop foundation" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Properties" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Native project format" TextColor="{StaticResource MutedTextColor}" />
                    <Label Text="{Binding NativeProjectExtension}" />
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                    <Label
                        FontSize="12"
                        Text="Sprite regions, connectors, tags, and export settings will appear here as their implementation phases land."
                        TextColor="{StaticResource MutedTextColor}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
