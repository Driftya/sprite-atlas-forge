<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Driftya.SpriteAtlasForge.ClientApplication.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Driftya.SpriteAtlasForge.Domain;assembly=Driftya.SpriteAtlasForge.Domain"
    xmlns:pageModels="clr-namespace:Driftya.SpriteAtlasForge.ClientApplication.PageModels"
    x:DataType="pageModels:WorkspacePageModel"
    Title="Atlas Workspace">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Open image" Command="{Binding OpenImageCommand}" />
                <Button Grid.Column="1" Text="Open project" Command="{Binding OpenProjectCommand}" />
                <Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="3" Text="Validate" Command="{Binding ValidateCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="4" Text="Repack" Command="{Binding RepackCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="5" Text="Export Phaser" Command="{Binding ExportPhaserCommand}" IsEnabled="{Binding HasProject}" />
                <ActivityIndicator Grid.Column="7" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="16" ColumnDefinitions="260,*,320" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Label Text="Sprites" Style="{StaticResource SectionTitleStyle}" />
                    <Label Grid.Row="1" Text="{Binding SpriteCountText}" TextColor="{StaticResource MutedTextColor}" />
                    <CollectionView
                        Grid.Row="2"
                        ItemsSource="{Binding Sprites}"
                        SelectedItem="{Binding SelectedSprite}"
                        SelectionMode="Single">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalTextAlignment="Center"
                                Text="No sprites detected"
                                TextColor="{StaticResource MutedTextColor}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:AtlasSprite">
                                <Grid Padding="8" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Id}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        Text="{Binding Connectors.Count, StringFormat='{0} points'}"
                                        TextColor="{StaticResource MutedTextColor}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CanvasBorderStyle}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Padding="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="Zoom" VerticalTextAlignment="Center" />
                        <Slider
                            Grid.Column="1"
                            Minimum="25"
                            Maximum="800"
                            Value="{Binding ZoomPercent}" />
                        <Label
                            Grid.Column="2"
                            Text="{Binding ZoomPercent, StringFormat='{0:F0}%'}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                    <ScrollView
                        Grid.Row="1"
                        Orientation="Both"
                        HorizontalScrollBarVisibility="Always"
                        VerticalScrollBarVisibility="Always">
                        <Image
                            Aspect="Fill"
                            HeightRequest="{Binding CanvasImageHeight}"
                            HorizontalOptions="Start"
                            Source="{Binding CurrentImagePath}"
                            VerticalOptions="Start"
                            WidthRequest="{Binding CanvasImageWidth}" />
                    </ScrollView>
                    <Label
                        Grid.Row="2"
                        Margin="8"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Status}"
                        TextColor="{StaticResource MutedTextColor}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Properties" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Sprite ID" TextColor="{StaticResource MutedTextColor}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding SpriteIdDraft}" Placeholder="Select a sprite" />
                            <Button Grid.Column="1" Text="Rename" Command="{Binding RenameSpriteCommand}" />
                        </Grid>

                        <Label Text="Source region" TextColor="{StaticResource MutedTextColor}" />
                        <Label Text="{Binding SelectedSprite.SourceRegion}" />
                        <Label Text="Atlas frame" TextColor="{StaticResource MutedTextColor}" />
                        <Label Text="{Binding SelectedSprite.Frame}" />

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <Label Text="Connectors" Style="{StaticResource SectionTitleStyle}" />
                        <CollectionView
                            ItemsSource="{Binding SelectedSprite.Connectors}"
                            SelectedItem="{Binding SelectedConnector}"
                            SelectionMode="Single"
                            HeightRequest="140">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="domain:AtlasConnector">
                                    <Grid Padding="0,4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" />
                                        <Label Grid.Column="1" Text="{Binding X, StringFormat='X {0}'}" />
                                        <Label Grid.Column="2" Text="{Binding Y, StringFormat='Y {0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Entry Placeholder="Connector name" Text="{Binding NewConnectorName}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Keyboard="Numeric" Placeholder="X" Text="{Binding NewConnectorX}" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Y" Text="{Binding NewConnectorY}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Add" Command="{Binding AddConnectorCommand}" />
                            <Button Grid.Column="1" Text="Update" Command="{Binding UpdateConnectorCommand}" />
                            <Button
                                Grid.Column="2"
                                Text="Delete"
                                Command="{Binding RemoveConnectorCommand}"
                                CommandParameter="{Binding SelectedConnector}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
