<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Driftya.SpriteAtlasForge.ClientApplication.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:Driftya.SpriteAtlasForge.Domain;assembly=Driftya.SpriteAtlasForge.Domain"
    xmlns:pageModels="clr-namespace:Driftya.SpriteAtlasForge.ClientApplication.PageModels"
    xmlns:controls="clr-namespace:Driftya.SpriteAtlasForge.ClientApplication.Pages.Controls"
    x:Name="RootPage"
    x:DataType="pageModels:WorkspacePageModel"
    Title="Atlas Workspace">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Clicked="OnAtlasHomeClicked"
                    SemanticProperties.Description="Sprite atlas workspace"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    Text="▦" />
                <BoxView Grid.Column="1" Margin="2,6" WidthRequest="1" Color="{StaticResource BorderColor}" />
                <Button Grid.Column="2" Text="Open image" Command="{Binding OpenImageCommand}" />
                <Button Grid.Column="3" Text="Open project" Command="{Binding OpenProjectCommand}" />
                <Button Grid.Column="4" Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="5" Text="Save as" Command="{Binding SaveAsCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="6" Text="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
                <Button Grid.Column="7" Text="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
                <Button Grid.Column="8" Text="Validate" Command="{Binding ValidateCommand}" IsEnabled="{Binding HasProject}" />
                <Button Grid.Column="9" Text="Repack" Command="{Binding RepackCommand}" IsEnabled="{Binding HasProject}" />
                <Picker Grid.Column="10" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" WidthRequest="150" />
                <Button Grid.Column="11" Text="Export" Command="{Binding ExportCommand}" IsEnabled="{Binding HasProject}" />
                <Button
                    Grid.Column="13"
                    Clicked="OnHelpClicked"
                    SemanticProperties.Description="Keyboard and mouse shortcuts"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    Text="?" />
                <Button Grid.Column="12" Text="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
                <ActivityIndicator Grid.Column="14" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="16" ColumnDefinitions="260,*,320" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <Label Text="Sprites" Style="{StaticResource SectionTitleStyle}" />
                    <Label Grid.Row="1" Text="{Binding SpriteCountText}" TextColor="{StaticResource MutedTextColor}" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Add sprite" Command="{Binding AddSpriteCommand}" IsEnabled="{Binding HasProject}" />
                        <Button
                            Grid.Column="1"
                            Text="Delete selected"
                            Command="{Binding DeleteSelectedSpriteCommand}"
                            IsEnabled="{Binding HasProject}" />
                    </Grid>
                    <CollectionView
                        Grid.Row="3"
                        ItemsSource="{Binding Sprites}"
                        SelectedItem="{Binding SelectedSprite}"
                        SelectionMode="Single">
                        <CollectionView.EmptyView>
                            <Label
                                HorizontalTextAlignment="Center"
                                Text="No sprites detected"
                                TextColor="{StaticResource MutedTextColor}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:AtlasSprite">
                                <Grid Padding="8" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Id}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        Text="{Binding Connectors.Count, StringFormat='{0} points'}"
                                        TextColor="{StaticResource MutedTextColor}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CanvasBorderStyle}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Padding="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="Zoom" VerticalTextAlignment="Center" />
                        <Slider
                            Grid.Column="1"
                            Minimum="25"
                            Maximum="800"
                            Value="{Binding ZoomPercent}" />
                        <Label
                            Grid.Column="2"
                            Text="{Binding ZoomPercent, StringFormat='{0:F0}%'}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                    <ScrollView
                        x:Name="AtlasScrollView"
                        Grid.Row="1"
                        Orientation="Both"
                        HorizontalScrollBarVisibility="Always"
                        VerticalScrollBarVisibility="Always">
                        <Grid
                            x:Name="AtlasCanvas"
                            SizeChanged="OnAtlasCanvasSizeChanged"
                            HeightRequest="{Binding CanvasImageHeight}"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="{Binding CanvasImageWidth}">
                            <Image Aspect="Fill" Source="{Binding CurrentImagePath}" />
                            <controls:SpriteOverlayView
                                CanResize="{Binding CanResizeSelectedSprite}"
                                CanvasPan="OnOverlayCanvasPan"
                                CanvasTapped="OnOverlayCanvasTapped"
                                CanvasZoomRequested="OnOverlayCanvasZoomRequested"
                                HeightRequest="{Binding CanvasImageHeight}"
                                HorizontalOptions="Fill"
                                Overlays="{Binding SpriteOverlays}"
                                SelectedSpriteId="{Binding SelectedSprite.Id}"
                                SourceHeight="{Binding SourceImageHeight}"
                                SourceWidth="{Binding SourceImageWidth}"
                                SpriteRegionResized="OnSpriteRegionResized"
                                SpriteSelected="OnOverlaySpriteSelected"
                                VerticalOptions="Fill"
                                WidthRequest="{Binding CanvasImageWidth}"
                                ZoomScale="{Binding CanvasZoomScale}"
                                x:Name="OverlayView" />
                            <AbsoluteLayout
                                CascadeInputTransparent="False"
                                InputTransparent="True"
                                BindableLayout.ItemsSource="{Binding ConnectorOverlays}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:ConnectorCanvasOverlay">
                                        <Grid
                                            HeightRequest="24"
                                            InputTransparent="False"
                                            TranslationX="{Binding X}"
                                            TranslationY="{Binding Y}"
                                            WidthRequest="100">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnConnectorPanUpdated" />
                                            </Grid.GestureRecognizers>
                                            <Ellipse
                                                HeightRequest="12"
                                                HorizontalOptions="Start"
                                                Fill="#FF4D6D"
                                                Stroke="White"
                                                StrokeThickness="1"
                                                VerticalOptions="Start"
                                                WidthRequest="12" />
                                            <Label Margin="16,-3,0,0" FontSize="10" Text="{Binding Name}" TextColor="White" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </AbsoluteLayout>
                        </Grid>
                    </ScrollView>
                    <Grid Grid.Row="2" Margin="8" RowDefinitions="Auto,Auto">
                        <ProgressBar Progress="{Binding ProgressFraction}" IsVisible="{Binding HasProgress}" />
                        <Label
                            Grid.Row="1"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Status}"
                            TextColor="{StaticResource MutedTextColor}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Properties" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Detection cleanup" Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="Auto learns a low-alpha cutoff to remove colored background noise, then removes small specks and one-pixel bridges. Use Alpha only, area 1, cleanup 0, and merge 0 for raw pixel art."
                            TextColor="{StaticResource MutedTextColor}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Background mode" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Picker
                                    ItemsSource="{Binding DetectionBackgroundModes}"
                                    SelectedItem="{Binding DetectionBackgroundMode}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Color tolerance (0-255)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="12" Text="{Binding DetectionBackgroundTolerance}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="Alpha cutoff (0-255)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="8" Text="{Binding DetectionAlphaThreshold}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="Minimum area (px²)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="64" Text="{Binding DetectionMinimumArea}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="2">
                                <Label Text="Cleanup radius (0-4 px)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="1" Text="{Binding DetectionNoiseReductionRadius}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                <Label Text="Merge distance (px)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="2" Text="{Binding DetectionMergeDistance}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="3" Spacing="2">
                                <Label Text="Source padding (px)" FontSize="11" TextColor="{StaticResource MutedTextColor}" />
                                <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding DetectionSourcePadding}" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox
                                    IsChecked="{Binding DetectionRecoverDetachedDetails}"
                                    Style="{StaticResource EditorCheckBoxStyle}" />
                                <Label
                                    Grid.Column="1"
                                    Text="Recover detached details (Auto only)"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Label
                            Text="These values are applied when you choose Open image. Merge distance joins regions across gaps; a large value can combine the whole sheet."
                            FontSize="11"
                            TextColor="{StaticResource MutedTextColor}" />
                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <Label Text="Sprite ID" TextColor="{StaticResource MutedTextColor}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding SpriteIdDraft}" Placeholder="Select a sprite" />
                            <Button Grid.Column="1" Text="Rename" Command="{Binding RenameSpriteCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <CheckBox
                                CheckedChanged="OnSpriteApprovedChanged"
                                IsChecked="{Binding IsSelectedSpriteApproved}"
                                Style="{StaticResource EditorCheckBoxStyle}" />
                            <Label
                                Grid.Column="1"
                                Text="Approved / verified — include in atlas export"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Grid>

                        <Label Text="Source region" TextColor="{StaticResource MutedTextColor}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Entry Keyboard="Numeric" Placeholder="X" Text="{Binding SourceRegionX}" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Y" Text="{Binding SourceRegionY}" />
                            <Entry Grid.Column="2" Keyboard="Numeric" Placeholder="Width" Text="{Binding SourceRegionWidth}" />
                            <Entry Grid.Column="3" Keyboard="Numeric" Placeholder="Height" Text="{Binding SourceRegionHeight}" />
                        </Grid>
                        <Button Text="Update region" Command="{Binding UpdateSpriteRegionCommand}" />
                        <Button
                            Text="Recover detached details"
                            Command="{Binding RecoverSelectedSpriteDetailsCommand}"
                            IsEnabled="{Binding CanResizeSelectedSprite}" />
                        <Button
                            Text="Save selected sprite as PNG"
                            Command="{Binding SaveSelectedSpriteImageCommand}"
                            IsEnabled="{Binding HasSelectedSprite}" />
                        <Label Text="Atlas frame" TextColor="{StaticResource MutedTextColor}" />
                        <Label Text="{Binding SelectedSprite.Frame}" />

                        <Label Text="Metadata tags" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource InsetPanelStyle}">
                            <CollectionView ItemsSource="{Binding SelectedSpriteMetadata}" HeightRequest="112">
                                <CollectionView.EmptyView>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="No metadata tags have been added."
                                        TextColor="{StaticResource MutedTextColor}"
                                        VerticalTextAlignment="Center" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:SpriteMetadataEntry">
                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Padding="0,2">
                                            <Label FontSize="12" Text="{Binding Key}" />
                                            <Label Grid.Column="1" FontSize="12" Text="{Binding Value}" TextColor="{StaticResource MutedTextColor}" />
                                            <Button
                                                Grid.Column="2"
                                                SemanticProperties.Description="Remove metadata tag"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.RemoveMetadataCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource CompactTextButtonStyle}"
                                                Text="×" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Entry Placeholder="Key" Text="{Binding NewMetadataKey}" />
                            <Entry Grid.Column="1" Placeholder="Value" Text="{Binding NewMetadataValue}" />
                        </Grid>
                        <Button Text="Add metadata tag" Command="{Binding AddMetadataCommand}" />

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <Label Text="Repack options" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Entry Keyboard="Numeric" Placeholder="Padding" Text="{Binding PackingPadding}" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Max width" Text="{Binding PackingMaximumWidth}" />
                            <Entry Grid.Column="2" Keyboard="Numeric" Placeholder="Max height" Text="{Binding PackingMaximumHeight}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding PackingPowerOfTwo}" Style="{StaticResource EditorCheckBoxStyle}" />
                            <Label
                                Grid.Column="1"
                                Text="Power-of-two atlas"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <Label Text="Connectors" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource InsetPanelStyle}">
                            <CollectionView
                                ItemsSource="{Binding SelectedSprite.Connectors}"
                                SelectedItem="{Binding SelectedConnector}"
                                SelectionMode="Single"
                                HeightRequest="132">
                                <CollectionView.EmptyView>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="No connectors have been added."
                                        TextColor="{StaticResource MutedTextColor}"
                                        VerticalTextAlignment="Center" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AtlasConnector">
                                        <Grid Padding="0,2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                            <Label FontSize="12" Text="{Binding Name}" />
                                            <Label Grid.Column="1" FontSize="11" Text="{Binding X, StringFormat='X {0}'}" TextColor="{StaticResource MutedTextColor}" />
                                            <Label Grid.Column="2" FontSize="11" Text="{Binding Y, StringFormat='Y {0}'}" TextColor="{StaticResource MutedTextColor}" />
                                            <Button
                                                Grid.Column="3"
                                                SemanticProperties.Description="Remove connector"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.RemoveConnectorCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource CompactTextButtonStyle}"
                                                Text="×" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <Entry Placeholder="Connector name (then click canvas or enter X/Y)" Text="{Binding NewConnectorName}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Keyboard="Numeric" Placeholder="X" Text="{Binding NewConnectorX}" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Y" Text="{Binding NewConnectorY}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Add" Command="{Binding AddConnectorCommand}" />
                            <Button Grid.Column="1" Text="Update" Command="{Binding UpdateConnectorCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
