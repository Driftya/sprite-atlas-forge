<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SpriteAtlasForge</AssemblyName>
    <RootNamespace>Driftya.SpriteAtlasForge.ClientApplication</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>Sprite Atlas Forge</ApplicationTitle>
    <ApplicationId>com.driftya.spriteatlasforge</ApplicationId>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <Version>1.0.1</Version>
    <Authors>Driftya</Authors>
    <Product>Sprite Atlas Forge</Product>
    <Description>A Windows desktop editor for detecting, authoring, repacking, and exporting sprite atlases.</Description>
    <Copyright>Copyright © 2026 Driftya</Copyright>
    <RepositoryUrl>https://github.com/Driftya/sprite-atlas-forge</RepositoryUrl>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Required by the Windows App SDK when publishing an unpackaged app for a specific RID. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17171A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Driftya.SpriteAtlasForge.Application\Driftya.SpriteAtlasForge.Application.csproj" />
    <ProjectReference Include="..\Driftya.SpriteAtlasForge.Infrastructure\Driftya.SpriteAtlasForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
